# ============================================================
# npm - Segurança
# ============================================================

# Registry oficial
registry=https://registry.npmjs.org/

# Manter package-lock.json
package-lock=true

# IMPORTANTE: não use save=false aqui. Ele impede o npm de atualizar o
# package-lock.json, fazendo o `npm ci` falhar (lock fora de sincronia) e
# impedindo o Dependabot de gerar PRs válidos. Use `npm install --no-save`
# pontualmente quando precisar apenas testar uma dependência.

# Scripts de instalação: falha em qualquer dependência com script não listado
# no campo allowScripts do package.json. A política fica versionada no projeto
# (nao no ~/.npmrc de cada maquina), para CI e clones novos funcionarem.
strict-allow-scripts=true

# Exigir TLS válido
strict-ssl=true

# Manter auditoria habilitada
audit=true
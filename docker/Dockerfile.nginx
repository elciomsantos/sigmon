# ============================================
# Build stage — compilar assets (Vite)
# ============================================
FROM node:24-slim AS build

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY vite.config.ts tsconfig.json postcss.config.js ./
COPY src/ src/
COPY public/ public/
COPY scripts/ scripts/
# O PurgeCSS (postcss.config.js) le os templates PHP para descobrir quais
# classes estao realmente em uso. Sem estas copias o build do Docker nao
# encontra resources/inc/auth/accounts e remove estilos de layout usados
# apenas nessas telas (navbar, cards do dashboard, centralizacao de paginas).
COPY resources/ resources/
COPY inc/ inc/
COPY auth/ auth/
COPY accounts/ accounts/
COPY api/ api/
COPY config/ config/
RUN npm run build

# ============================================
# PHP-FPM + Nginx
# ============================================
FROM php:8.4-fpm

LABEL org.opencontainers.image.source="https://github.com/defesatecnologia-lang/SIGMON"
LABEL org.opencontainers.image.description="Sistema de Gerenciamento de Cameras e Alarmes (Nginx)"
LABEL org.opencontainers.image.licenses="MIT"

ARG DEBIAN_FRONTEND=noninteractive

# hadolint ignore=DL3008
RUN apt-get update && apt-get install -y --no-install-recommends \
        nginx curl openssl libpng-dev libzip-dev libonig-dev \
        libxml2-dev libcurl4-openssl-dev pkg-config libssl-dev \
        libbrotli-dev libnginx-mod-http-brotli-static \
        locales \
    && sed -i 's/# pt_BR.UTF-8/pt_BR.UTF-8/' /etc/locale.gen \
    && locale-gen pt_BR.UTF-8 \
    && docker-php-ext-install pdo_mysql mbstring zip gd xml curl \
    && pecl install apcu && docker-php-ext-enable apcu \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Copiar composer e instalar dependencias PHP
COPY --from=composer:2 /usr/bin/composer /usr/local/bin/composer

WORKDIR /var/www/html

COPY composer.json composer.lock ./

# Copiar codigo-fonte antes do composer install (classmap precisa do src/)
COPY . .

RUN composer install --no-interaction --optimize-autoloader --classmap-authoritative --no-dev

# Copiar assets buildados do stage de build (dist/.vite/manifest.json para o PHP;
# dist/assets/ para public/assets/ — docroot do Nginx serve /assets/*).
COPY --from=build /app/dist/ dist/
COPY --from=build /app/dist/assets/ public/assets/
# Webfonts do Font Awesome: o postbuild copia para public/assets/webfonts,
# que nao faz parte de dist/assets — sem esta linha os icones retornam 404.
COPY --from=build /app/public/assets/webfonts/ public/assets/webfonts/
# Lista de assets para o pre-cache do Service Worker (gerada no postbuild).
COPY --from=build /app/public/sw-assets.json public/sw-assets.json

# Configuracoes PHP
RUN echo "memory_limit = 256M" > /usr/local/etc/php/conf.d/memory.ini \
    && echo "upload_max_filesize = 20M" > /usr/local/etc/php/conf.d/upload.ini \
    && echo "post_max_size = 20M" >> /usr/local/etc/php/conf.d/upload.ini \
    && echo "max_execution_time = 120" > /usr/local/etc/php/conf.d/timeout.ini \
    && echo "opcache.enable=1" > /usr/local/etc/php/conf.d/opcache.ini \
    && echo "opcache.memory_consumption=128" >> /usr/local/etc/php/conf.d/opcache.ini \
    && echo "opcache.interned_strings_buffer=8" >> /usr/local/etc/php/conf.d/opcache.ini \
    && echo "opcache.max_accelerated_files=10000" >> /usr/local/etc/php/conf.d/opcache.ini \
    && echo "opcache.revalidate_freq=2" >> /usr/local/etc/php/conf.d/opcache.ini \
    && echo "opcache.save_comments=1" >> /usr/local/etc/php/conf.d/opcache.ini \
    && echo "apc.enabled=1" >> /usr/local/etc/php/conf.d/opcache.ini \
    && echo "apc.shm_size=32M" >> /usr/local/etc/php/conf.d/opcache.ini

# Configurar PHP-FPM para ouvir na porta 9000
RUN sed -i 's|^listen = /run/php/php8.4-fpm.sock|listen = 9000|' /usr/local/etc/php-fpm.d/www.conf \
    && sed -i 's|^;clear_env = no|clear_env = no|' /usr/local/etc/php-fpm.d/www.conf

# Copiar configuracao do Nginx
COPY docker/nginx.conf /etc/nginx/nginx.conf
# Locations compartilhadas (incluidas dentro do server gerado pelo entrypoint)
COPY docker/locations.conf /etc/nginx/locations.conf
# Entrypoint (gera certs self-signed/CA e o bloco server HTTPS + redirect)
COPY docker/nginx-entrypoint.sh /usr/local/bin/nginx-entrypoint.sh
RUN chmod +x /usr/local/bin/nginx-entrypoint.sh

# Diretorio de certificados TLS (volume nomeado no compose) e tmpfs /run/nginx_conf
RUN mkdir -p /etc/nginx/certs /run/nginx_conf \
    && chown -R www-data:www-data /etc/nginx/certs /run/nginx_conf \
    && chmod 750 /etc/nginx/certs

# Diretorios de storage
RUN mkdir -p storage/ratelimit storage/cep_cache public/uploads \
    && chown -R www-data:www-data storage public/uploads \
    && chmod -R 755 storage public/uploads

ENV SIGMON_ENV=production

# Versao exibida no rodape (tag semver do CD, ex.: v1.0.2).
# O workflow .github/workflows/cd.yml passa APP_VERSION como build-arg;
# quando ausente, a interface omite o numero em vez de exibir um valor falso.
ARG APP_VERSION=dev
ENV APP_VERSION=${APP_VERSION}

# Remover default do Nginx (evitar conflito)
RUN rm -f /etc/nginx/sites-enabled/default \
    && mkdir -p /run/php /var/cache/nginx /var/log/nginx /var/lib/nginx/body \
    && touch /run/php/php-fpm.pid /var/run/nginx.pid /var/log/nginx/access.log /var/log/nginx/error.log \
    && chown -R www-data:www-data /run/php /var/cache/nginx /var/log/nginx /var/lib/nginx \
    && chown www-data:www-data /var/run/nginx.pid

EXPOSE 8080 8443

# Em SIGMON_HTTP_ONLY=1 (padrao) a app responde em 8080; em modo TLS em 8443.
HEALTHCHECK --interval=30s --timeout=10s --start-period=15s --retries=3 \
    CMD if [ "${SIGMON_HTTP_ONLY:-1}" = "1" ] || [ "${SIGMON_HTTP_ONLY:-1}" = "true" ]; then \
          curl -fsS http://localhost:8080/ >/dev/null || exit 1; \
        else \
          curl -kfsS https://localhost:8443/ >/dev/null || exit 1; \
        fi

# Rodar como www-data (nao root) — nginx master + php-fpm
USER www-data

CMD ["/usr/local/bin/nginx-entrypoint.sh"]
